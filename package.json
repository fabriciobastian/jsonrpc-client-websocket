{
  "name": "jsonrpc-client-websocket",
  "version": "1.5.5",
  "description": "A simple JSON RPC 2.0 websocket client",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "test": "tsc --project tsconfig.spec.json && jest",
    "coverage": "npm test -- --coverage",
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "tsc --noEmit && eslint .",
    "prepublishOnly": "npm test && npm run lint",
    "prepare": "npm run build",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags",
    "update-all": "npm-check-updates --upgrade --peer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabriciobastian/jsonrpc-client-websocket.git"
  },
  "bugs": {
    "url": "https://github.com/fabriciobastian/jsonrpc-client-websocket/issues"
  },
  "homepage": "https://github.com/fabriciobastian/jsonrpc-client-websocket#readme",
  "keywords": [
    "websocket",
    "jsonrpc",
    "client",
    "json",
    "rpc"
  ],
  "author": "Fabricio Bastian",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-websocket-mock": "^2.5.0",
    "mock-socket": "^9.3.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
